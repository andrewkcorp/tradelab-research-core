__pycache__/
*.py[cod]
.env
.env.*
backtest_results.json

# Local MNQ research artifacts (tradelab.materialize_research_artifact) --
# generated data + audit JSON, never real market data checked into git.
# Matches the exact filenames the CLI writes, wherever they land, plus the
# conventional local output directory name so an --output-dir pointed
# inside the repo (e.g. for local testing) can never be committed by accident.
tradelab_mnq_research_artifact/
**/tradelab_mnq_research_artifact/
mnq_continuous_1m.csv
source_artifact_manifest.json
continuous_artifact_manifest.json
volume_roll_audit.json
materialization_summary.json

# Local research context profile (tradelab.profile_research_context) --
# a small diagnostic JSON derived from real market/news data, never
# committed. --output-json is always caller-supplied at runtime; this
# pattern only guards against it being pointed inside the repo by
# accident (e.g. for local testing).
context_profile.json

# Local research journal databases (tradelab.research_journal) -- SQLite
# checkpoint/resume state and any exported qualifying-strategy results,
# never committed. db_path/export path are always caller-supplied at
# runtime; these patterns only guard against one being pointed inside
# the repo by accident (e.g. for local testing).
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
research_journal.sqlite3

# Local research run artifacts (tradelab.research_run / tradelab.
# research_demo / tradelab.research_dashboard) -- live-status/checkpoint/
# leaderboard JSON and progress event logs for a research run (demo or
# real), never committed. --runs-dir is always caller-supplied at
# runtime; this pattern only guards against the conventional ./runs
# default landing inside the repo by accident (e.g. for local testing).
/runs/
**/runs/

# Ad-hoc diagnostic probe outputs (the probe scripts themselves stay tracked).
.diag/*.log
.diag/*.pkl
.diag/*.txt
